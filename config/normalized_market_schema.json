{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Market Observation v1.2 prototype",
  "description": "PREP-only schema. No provider admission or forecast authorization. Cross-field OHLC order, uniqueness, calendar and availability ordering require the accompanying semantic validator.",
  "type": "object",
  "required": [
    "symbol",
    "issuer_id",
    "exchange",
    "currency",
    "session_date",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "trading_value",
    "dividend",
    "split_factor",
    "series_type",
    "provider",
    "observation_time",
    "published_time",
    "available_at",
    "retrieved_at",
    "quality_state",
    "source_reference",
    "normalization",
    "primary_price_direction_eligible",
    "quality_flags"
  ],
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "issuer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "exchange": {
      "type": "string",
      "pattern": "^[A-Z0-9]{4}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "session_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "open": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "high": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "low": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "close": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "volume": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "trading_value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "dividend": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "split_factor": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "description": "Cumulative divisor converting native pre-split price to the stated normalization basis. Null when unknown; do not assume 1."
    },
    "series_type": {
      "enum": [
        "RAW_OHLC",
        "SPLIT_NORMALIZED_OHLC",
        "TOTAL_RETURN_REFERENCE",
        null
      ],
      "description": "Null only for incomplete records with unknown adjustment basis. auto_adjust=false does not itself prove native unadjusted OHLC."
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "observation_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "published_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "available_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "First proven availability, not observation time. Unknown provider publication time remains null; retrieved_at records this observation separately."
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "quality_state": {
      "enum": [
        "OK",
        "PARTIAL_DATA",
        "STALE_DATA",
        "INSUFFICIENT_DATA",
        "DATA_CONFLICT"
      ]
    },
    "source_reference": {
      "type": "object",
      "required": [
        "reference",
        "provider_timestamp",
        "price_basis_status",
        "notes"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "price_basis_status": {
          "enum": [
            "VERIFIED",
            "NOT_VALIDATED"
          ]
        },
        "source_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_price_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "normalization": {
      "type": "object",
      "required": [
        "basis_session",
        "method",
        "dividend_included"
      ],
      "properties": {
        "basis_session": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "dividend_included": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "primary_price_direction_eligible": {
      "type": "boolean",
      "description": "False for total return or incomplete data. True still requires separately approved runtime and source admission."
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "quality_state": {
            "const": "OK"
          }
        }
      },
      "then": {
        "properties": {
          "session_date": {
            "not": {
              "type": "null"
            }
          },
          "open": {
            "not": {
              "type": "null"
            }
          },
          "high": {
            "not": {
              "type": "null"
            }
          },
          "low": {
            "not": {
              "type": "null"
            }
          },
          "close": {
            "not": {
              "type": "null"
            }
          },
          "volume": {
            "not": {
              "type": "null"
            }
          },
          "series_type": {
            "not": {
              "type": "null"
            }
          },
          "observation_time": {
            "not": {
              "type": "null"
            }
          },
          "available_at": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "series_type": {
            "const": "TOTAL_RETURN_REFERENCE"
          }
        }
      },
      "then": {
        "properties": {
          "primary_price_direction_eligible": {
            "const": false
          },
          "normalization": {
            "properties": {
              "dividend_included": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "series_type": {
            "enum": [
              "RAW_OHLC",
              "SPLIT_NORMALIZED_OHLC"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "normalization": {
            "properties": {
              "dividend_included": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "series_type": {
            "const": "SPLIT_NORMALIZED_OHLC"
          }
        }
      },
      "then": {
        "properties": {
          "split_factor": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "normalization": {
            "properties": {
              "basis_session": {
                "type": "string",
                "format": "date"
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "series_type": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "quality_state": {
            "not": {
              "const": "OK"
            }
          },
          "primary_price_direction_eligible": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "primary_price_direction_eligible": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "quality_state": {
            "const": "OK"
          },
          "series_type": {
            "enum": [
              "RAW_OHLC",
              "SPLIT_NORMALIZED_OHLC"
            ]
          },
          "source_reference": {
            "properties": {
              "price_basis_status": {
                "const": "VERIFIED"
              }
            }
          }
        }
      }
    }
  ]
}
